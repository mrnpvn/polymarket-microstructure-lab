[Unit]
Description=PolyBot read-only Polymarket maker-shadow recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=polybot
Group=polybot
WorkingDirectory=/opt/polybot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/polybot/.venv/bin/python -m maker_shadow.record_book
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/polybot/maker_shadow
